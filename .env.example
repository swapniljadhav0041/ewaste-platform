# ==============================================
# E-Waste Credits Platform - Environment Configuration
# ==============================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connection (PostgreSQL with Prisma)
# Replace with your local PostgreSQL or cloud provider (e.g. Supabase, Neon)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ewaste_db?schema=public"

# Authentication Secrets
JWT_SECRET="super-secret-jwt-key-change-in-production-min-32-chars"
JWT_EXPIRES_IN="7d"

# Cloudinary / File Uploads (Optional in local dev fallback mode)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# Bonus Credit Configuration
FIRST_SUBMISSION_BONUS=50
BULK_THRESHOLD=10
BULK_BONUS_PERCENT=10
REFERRAL_BONUS=25
